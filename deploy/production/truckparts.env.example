# VentureERP — ambiente da TRUCKPARTS IMPLEMENTOS RODOVIARIOS LTDA
# (CNPJ 64.815.197/0001-08, Mandaguari-PR, Simples Nacional). Empresa do grupo
# Tecnofer: base, usuários e senhas próprios; o login do desktop oferece as duas.
#
# Copie para /opt/venturerp/panossoerp/.env.truckparts na VPS, com modo 0600, e
# troque cada CHANGE_ME. Nunca versione o arquivo resultante.

SERVER_ADDR=5076
ENV=production
DATA_ENVIRONMENT=production
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_SEC=15

# Base exclusiva. O role venturerp_truckparts não tem CONNECT nas bases da
# Tecnofer e da Usimac, e o inverso também vale — mesmo sendo o mesmo grupo.
DATABASE_URL=postgres://venturerp_truckparts:CHANGE_ME@127.0.0.1:5432/venturerp_truckparts?sslmode=disable

# IDENTITY_DATABASE_URL fica AUSENTE: os usuários da Truckparts moram na base da
# Truckparts. Emprestar a autenticação da Tecnofer misturaria as duas empresas.

# ⚠️ OBRIGATORIAMENTE diferente do JWT_SECRET da Tecnofer e da Usimac: um token
# da Tecnofer não pode abrir a Truckparts só porque o grupo é o mesmo.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

CORS_ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost
RATE_LIMIT_RPS=25
RATE_LIMIT_BURST=50
AUTH_RATE_LIMIT_RPM=20
AUTH_RATE_LIMIT_BURST=10
MAX_BODY_BYTES=10485760

METRICS_ENABLED=true
METRICS_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_STRING
TRUSTED_PROXY_CIDRS=127.0.0.1/32
OTEL_SERVICE_NAME=venturerp-api-truckparts
OTEL_SERVICE_NAMESPACE=venturerp
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production,tenant=truckparts
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Pool de conexões. Todas as empresas dividem o max_connections=100 do
# PostgreSQL: 25 (Tecnofer) + 15 (Usimac) + 10 (Truckparts) + 8 (treinamento)
# = 58, com folga para backup, superusuário e monitoramento.
# DB_MIN_CONNS=1: empresa pequena, uma conexão quente basta e devolve memória.
DB_MAX_CONNS=10
DB_MIN_CONNS=1
DB_MAX_CONN_LIFETIME_MIN=60
DB_MAX_CONN_IDLE_MIN=10

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Fila de atualização montada só-leitura: quem dispara o update é a Tecnofer.
SYSTEM_UPDATE_DIR=/var/lib/venturerp-update
BACKEND_RELEASE_URL=https://api.github.com/repos/FelipePn10/venturerp/releases/latest

NESTING_SERVICE_URL=

# O runtime do Go não enxerga o mem_limit do contêiner (384m): com este teto
# o GC aperta antes de o kernel matar o processo por falta de memória.
GOMEMLIMIT=320MiB
