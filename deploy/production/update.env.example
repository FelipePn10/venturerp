# Instalado como /etc/venturerp/update.env com modo 0600.
#
# O tenant principal é descrito pelos campos sem prefixo. Cada empresa cliente
# adicional entra em VENTURERP_TENANTS e ganha um bloco TENANT_<NOME>_*. Backup,
# migration, health-check e rollback percorrem essa lista, então incluir um
# cliente no ciclo de atualização é só configuração — self-update.sh não muda.

IMAGE_REPOSITORY=ghcr.io/felipepn10/panossoerp
COMPOSE_FILE=/opt/venturerp/updater/compose.yml
UPDATE_DIR=/var/lib/venturerp-update
BACKUP_DIR=/var/backups/venturerp/releases
DATABASE_CONTAINER=venturerp-postgres
LEGACY_SERVICE=venturerp.service
HEALTH_ATTEMPTS=30
HEALTH_INTERVAL_SECONDS=2

# ── Tenant principal (Tecnofer) ───────────────────────────────────────────────
API_ENV_FILE=/opt/venturerp/panossoerp/.env
DATABASE_USER=venturerp_app
DATABASE_NAME=venturerp
DATABASE_URL=postgres://venturerp_app:CHANGE_ME@127.0.0.1:5432/venturerp?sslmode=disable
HEALTH_URL=http://127.0.0.1:5070/health/ready
# Opcional: o self-update deriva a senha do DATABASE_URL. Defina apenas se a
# senha contiver caracteres que o parser de URL não consiga extrair.
# DATABASE_PASSWORD=CHANGE_ME

# ── Empresas clientes adicionais ──────────────────────────────────────────────
# Lista separada por espaços. O nome vira o perfil do compose e o prefixo das
# variáveis (usimac → TENANT_USIMAC_*). Duas empresas apontando para a mesma base
# fazem o self-update abortar antes do primeiro backup.
VENTURERP_TENANTS=usimac

TENANT_USIMAC_DATABASE_URL=postgres://venturerp_usimac:CHANGE_ME@127.0.0.1:5432/venturerp_usimac?sslmode=disable
TENANT_USIMAC_API_ENV_FILE=/opt/venturerp/panossoerp/.env.usimac
TENANT_USIMAC_HEALTH_URL=http://127.0.0.1:5075/health/ready
# Opcionais: derivados do nome e do DATABASE_URL quando omitidos.
# TENANT_USIMAC_PROFILE=usimac
# TENANT_USIMAC_COMPOSE_ENV_VAR=VENTURERP_USIMAC_API_ENV
# TENANT_USIMAC_DATABASE_USER=venturerp_usimac
# TENANT_USIMAC_DATABASE_NAME=venturerp_usimac
# TENANT_USIMAC_DATABASE_PASSWORD=CHANGE_ME

# ── Ambiente de treinamento ───────────────────────────────────────────────────
# Formato legado, ainda aceito: descreve o treinamento fora de VENTURERP_TENANTS.
# Recebe migrations, mas nunca entra no pg_dump de produção de outra empresa.
TRAINING_API_ENV_FILE=/opt/venturerp/panossoerp/.env.training
TRAINING_DATABASE_URL=postgres://venturerp_training:CHANGE_ME@127.0.0.1:5432/venturerp_training?sslmode=disable
TRAINING_HEALTH_URL=http://127.0.0.1:5071/health/ready
