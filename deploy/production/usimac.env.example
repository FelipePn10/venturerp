# VentureERP — ambiente da USIMAC USINAGEM TATUI LTDA (CNPJ 20.820.705/0001-62).
#
# Copie para /opt/venturerp/panossoerp/.env.usimac na VPS, com modo 0600, e
# troque cada CHANGE_ME. Nunca versione o arquivo resultante.
#
# Este arquivo descreve UMA empresa cliente. O isolamento em relação à Tecnofer
# é físico: database próprio, role próprio do PostgreSQL e contêiner próprio.

SERVER_ADDR=5075
ENV=production
# Produção de verdade: a Usimac emite documento fiscal por este ambiente. O valor
# `training` desliga a emissão em produção no provedor fiscal.
DATA_ENVIRONMENT=production
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_SEC=15

# Base exclusiva da Usimac. O role venturerp_usimac não tem GRANT algum sobre a
# base da Tecnofer, e o inverso também é verdade.
DATABASE_URL=postgres://venturerp_usimac:CHANGE_ME@127.0.0.1:5432/venturerp_usimac?sslmode=disable

# IDENTITY_DATABASE_URL fica AUSENTE de propósito. Ele existe para o ambiente de
# treinamento, que empresta a autenticação da produção. Aqui os usuários da
# Usimac moram na própria base da Usimac.

# ⚠️ OBRIGATORIAMENTE diferente do JWT_SECRET da Tecnofer.
# O token carrega o usuário e a empresa, e é validado apenas pela assinatura. Com
# o mesmo segredo nos dois ambientes, um token emitido pela API da Tecnofer seria
# aceito pela API da Usimac — cada empresa precisa da sua própria chave.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Origens do app desktop (WebView do Tauri v2). Deny-by-default.
CORS_ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost
# Quatro usuários nomeados (Jhonata, Adriana, Renato, Rodrigo). Limites menores
# que os da Tecnofer contêm o estrago de um laço acidental no cliente.
RATE_LIMIT_RPS=25
RATE_LIMIT_BURST=50
AUTH_RATE_LIMIT_RPM=20
AUTH_RATE_LIMIT_BURST=10
MAX_BODY_BYTES=10485760

METRICS_ENABLED=true
# Também diferente do token da Tecnofer: são superfícies de métrica distintas.
METRICS_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_STRING
TRUSTED_PROXY_CIDRS=127.0.0.1/32
OTEL_SERVICE_NAME=venturerp-api-usimac
OTEL_SERVICE_NAMESPACE=venturerp
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production,tenant=usimac
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Remetente dos documentos fiscais da Usimac. A caixa nfe@usimacusinagem.com.br é
# compartilhada e não consome licença de usuário.
# Pool de conexões desta API. O padrão do pgxpool é max(4, NumCPU) — na VPS de
# 3 vCPU isso daria QUATRO conexões para a empresa inteira, e um relatório longo
# enfileiraria as telas de todo mundo. O teto abaixo é de Usimac, quatro usuários nomeados.
#
# Todas as empresas dividem o mesmo max_connections=100 do PostgreSQL: 25
# (Tecnofer) + 15 (Usimac) + 8 (treinamento) = 48, com folga para backup,
# superusuário e monitoramento. Ao somar um cliente, reveja esta conta.
DB_MAX_CONNS=15
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME_MIN=60
DB_MAX_CONN_IDLE_MIN=15

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=nfe@usimacusinagem.com.br

# A fila de atualização da VPS é montada somente leitura neste contêiner: a
# Usimac acompanha o status da plataforma, mas quem dispara a atualização é o
# ambiente principal. Pedir daqui devolve 403 com essa explicação.
SYSTEM_UPDATE_DIR=/var/lib/venturerp-update
BACKEND_RELEASE_URL=https://api.github.com/repos/FelipePn10/venturerp/releases/latest

NESTING_SERVICE_URL=
