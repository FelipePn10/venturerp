[Unit]
Description=VentureERP training copy (modo simulação)
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/venturerp/updater/refresh-training.sh
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/venturerp-simulacao /run/lock
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
