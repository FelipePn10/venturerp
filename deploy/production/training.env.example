# Segunda instância do VentureERP. Nunca reutilize o banco de produção em
# DATABASE_URL. IDENTITY_DATABASE_URL é somente a autoridade de autenticação.
SERVER_ADDR=5071
ENV=production
DATA_ENVIRONMENT=training
LOG_LEVEL=info
DATABASE_URL=postgres://venturerp_training:CHANGE_ME@127.0.0.1:5432/venturerp_training?sslmode=disable
IDENTITY_DATABASE_URL=postgres://venturerp_app:CHANGE_ME@127.0.0.1:5432/venturerp?sslmode=disable
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

CORS_ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
AUTH_RATE_LIMIT_RPM=20
AUTH_RATE_LIMIT_BURST=10
MAX_BODY_BYTES=10485760
METRICS_ENABLED=true
METRICS_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_STRING
SHUTDOWN_TIMEOUT_SEC=15
OTEL_SERVICE_NAME=venturerp-api-training
OTEL_SERVICE_NAMESPACE=venturerp
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=training
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# E-mails reais são permitidos, mas o backend prefixa assunto e corpo como
# treinamento/sem valor. Prefira uma conta remetente dedicada.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

SYSTEM_UPDATE_DIR=/var/lib/venturerp-update
BACKEND_RELEASE_URL=https://api.github.com/repos/FelipePn10/venturerp/releases/latest
NESTING_SERVICE_URL=
